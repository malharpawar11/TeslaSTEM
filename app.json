{
  "expo": {
    "name": "Tesla STEM Clubs",
    "slug": "tesla-stem-clubs",
    "scheme": "teslastemclubs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./teslastemlogo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./teslastemlogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#050807"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.teslastem.clubs",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Club notifications are sent only for clubs you follow."
      }
    },
    "android": {
      "package": "org.teslastem.clubs",
      "adaptiveIcon": {
        "foregroundImage": "./teslastemlogo.png",
        "backgroundColor": "#050807"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./teslastemlogo.png",
      "bundler": "metro",
      "output": "single",
      "name": "Tesla STEM Clubs",
      "shortName": "ClubHub",
      "description": "School club directory for Tesla STEM High School: browse clubs, follow updates, submit new clubs.",
      "themeColor": "#1565C0",
      "backgroundColor": "#050807",
      "lang": "en"
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    },
    "plugins": [
      "expo-router"
    ]
  }
}
