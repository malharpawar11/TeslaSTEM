# ----- runtime -----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ----- database -----
# postgres connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clubhub?schema=public

# ----- redis -----
REDIS_URL=redis://localhost:6379

# ----- auth / jwt -----
# 32+ random bytes, base64 or hex. ROTATE on incident.
JWT_ACCESS_SECRET=replace-me-with-32-bytes-min
JWT_REFRESH_SECRET=replace-me-with-32-bytes-min
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=clubhub
JWT_AUDIENCE=clubhub-mobile

# ----- school identity policy -----
# comma-separated list of allowed email domains for signup / OAuth
SCHOOL_EMAIL_DOMAINS=lwsd.org

# ----- OAuth providers -----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# ----- CORS -----
# comma-separated origins; use exact origins, never *
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ----- security -----
# bcrypt-equivalent argon2 cost; do not lower in prod
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# trust proxy hop count when behind a load balancer (Cloud Run/ALB/Fly)
TRUST_PROXY_HOPS=1

# bootstrap super-admin email (created on first boot if no super admin exists)
BOOTSTRAP_SUPER_ADMIN_EMAIL=
